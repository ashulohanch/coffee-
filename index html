<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ONE CUP OF COFFEE — One Cup. One Moment. One Story.</title>
<meta name="description" content="One Cup of Coffee — a premium café brand. Freshly brewed coffee, handcrafted moments, and a cozy place to slow down.">

<!-- Google Fonts: Fraunces (serif, characterful headings) + Manrope (clean sans body) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
/* ==========================================================================
   0. ROOT VARIABLES — BRAND TOKENS
   ========================================================================== */
:root{
  --espresso: #3B2418;
  --dark-coffee: #24140E;
  --cream: #FFF8ED;
  --beige: #D8B892;
  --caramel: #B87945;
  --gold: #C9A66B;
  --white: #FFFFFF;

  --font-display: 'Fraunces', serif;
  --font-body: 'Manrope', sans-serif;

  --radius-sm: 10px;
  --radius-md: 18px;
  --radius-lg: 28px;

  --shadow-soft: 0 20px 50px -20px rgba(36, 20, 14, 0.35);
  --shadow-card: 0 10px 30px -12px rgba(36, 20, 14, 0.25);

  --ease: cubic-bezier(.22,1,.36,1);
}

/* ==========================================================================
   1. RESET & BASE
   ========================================================================== */
*, *::before, *::after{ box-sizing: border-box; margin:0; padding:0; }
html{ scroll-behavior: smooth; }
body{
  font-family: var(--font-body);
  background: var(--cream);
  color: var(--espresso);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
img{ max-width: 100%; display: block; }
a{ text-decoration: none; color: inherit; }
ul{ list-style: none; }
button{ font-family: inherit; cursor: pointer; border: none; background: none; }
input, textarea{ font-family: inherit; }

::selection{ background: var(--caramel); color: var(--white); }

/* subtle grain / warmth overlay used across dark sections */
.grain{
  position: absolute; inset: 0;
  background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.035) 1px, transparent 0);
  background-size: 3px 3px;
  pointer-events: none;
}

.container{
  width: 100%;
  max-width: 1220px;
  margin: 0 auto;
  padding: 0 32px;
}

.eyebrow{
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-body);
  font-size: 0.78rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--caramel);
  font-weight: 700;
  margin-bottom: 18px;
}
.eyebrow::before{
  content: "";
  width: 26px; height: 1px;
  background: var(--caramel);
}

.section-title{
  font-family: var(--font-display);
  font-weight: 600;
  font-size: clamp(2rem, 4vw, 3rem);
  color: var(--dark-coffee);
  letter-spacing: -0.01em;
  line-height: 1.15;
}

.section-sub{
  max-width: 560px;
  color: #6b5142;
  font-size: 1.02rem;
  margin-top: 14px;
}

.section-head{
  margin-bottom: 56px;
}
.section-head.center{
  text-align: center;
  margin-left: auto;
  margin-right: auto;
}
.section-head.center .section-sub{ margin-left: auto; margin-right: auto; }

section{ position: relative; }

/* Buttons */
.btn{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 16px 34px;
  border-radius: 100px;
  font-weight: 700;
  font-size: 0.92rem;
  letter-spacing: 0.02em;
  transition: transform .45s var(--ease), box-shadow .45s var(--ease), background .35s ease, color .35s ease;
  white-space: nowrap;
}
.btn-primary{
  background: linear-gradient(135deg, var(--caramel), var(--gold));
  color: var(--white);
  box-shadow: 0 12px 30px -10px rgba(184, 121, 69, 0.65);
}
.btn-primary:hover{
  transform: translateY(-3px);
  box-shadow: 0 18px 36px -10px rgba(184, 121, 69, 0.8);
}
.btn-outline{
  background: transparent;
  border: 1.5px solid var(--espresso);
  color: var(--espresso);
}
.btn-outline:hover{
  background: var(--espresso);
  color: var(--cream);
  transform: translateY(-3px);
}
.btn-light{
  background: var(--cream);
  color: var(--dark-coffee);
}
.btn-light:hover{
  background: var(--white);
  transform: translateY(-3px);
  box-shadow: 0 14px 30px -12px rgba(0,0,0,0.3);
}
.btn-sm{ padding: 11px 24px; font-size: 0.82rem; }

/* Scroll reveal base */
.reveal{
  opacity: 0;
  transform: translateY(36px);
  transition: opacity .9s var(--ease), transform .9s var(--ease);
  will-change: transform, opacity;
}
.reveal.in-view{
  opacity: 1;
  transform: translateY(0);
}
.reveal-delay-1{ transition-delay: .1s; }
.reveal-delay-2{ transition-delay: .2s; }
.reveal-delay-3{ transition-delay: .3s; }
.reveal-delay-4{ transition-delay: .4s; }

/* ==========================================================================
   2. NAVIGATION
   ========================================================================== */
.navbar{
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  padding: 22px 0;
  transition: all .5s var(--ease);
}
.navbar.scrolled{
  padding: 12px 0;
  background: rgba(255, 248, 237, 0.88);
  backdrop-filter: blur(14px) saturate(140%);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  box-shadow: 0 8px 30px -16px rgba(36,20,14,0.25);
}
.nav-inner{
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.logo{
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-display);
  line-height: 1.05;
  transition: color .4s ease;
}
.logo-icon{
  font-size: 1.6rem;
  transform: translateY(-1px);
}
.logo-text{
  font-weight: 700;
  font-size: 1.02rem;
  letter-spacing: 0.03em;
  color: var(--dark-coffee);
}
.logo-text span{
  display: block;
  font-size: 0.66rem;
  font-family: var(--font-body);
  font-weight: 700;
  letter-spacing: 0.28em;
  color: var(--caramel);
  margin-top: 2px;
}

.nav-links{
  display: flex;
  align-items: center;
  gap: 38px;
}
.nav-links a{
  position: relative;
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--espresso);
  padding: 6px 0;
  transition: color .3s ease;
}
.nav-links a::after{
  content: "";
  position: absolute;
  left: 0; bottom: 0;
  width: 0; height: 2px;
  background: var(--caramel);
  transition: width .35s var(--ease);
  border-radius: 2px;
}
.nav-links a:hover::after,
.nav-links a.active::after{ width: 100%; }
.nav-links a.active{ color: var(--caramel); }

.nav-cta{ display: flex; align-items: center; gap: 18px; }

.hamburger{
  display: none;
  flex-direction: column;
  gap: 5px;
  width: 30px;
  z-index: 1200;
}
.hamburger span{
  display: block;
  height: 2px;
  background: var(--dark-coffee);
  border-radius: 2px;
  transition: all .4s var(--ease);
}
.hamburger.open span:nth-child(1){ transform: translateY(7px) rotate(45deg); }
.hamburger.open span:nth-child(2){ opacity: 0; }
.hamburger.open span:nth-child(3){ transform: translateY(-7px) rotate(-45deg); }

.mobile-menu{
  position: fixed;
  inset: 0;
  background: var(--dark-coffee);
  z-index: 1100;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transform: translateY(-100%);
  transition: transform .55s var(--ease);
}
.mobile-menu.open{ transform: translateY(0); }
.mobile-menu a{
  color: var(--cream);
  font-family: var(--font-display);
  font-size: 1.7rem;
  padding: 14px 0;
  font-weight: 500;
  opacity: 0.9;
  transition: opacity .3s ease, letter-spacing .3s ease;
}
.mobile-menu a:hover{ opacity: 1; letter-spacing: 0.02em; color: var(--gold); }
.mobile-menu .btn{ margin-top: 24px; }

/* ==========================================================================
   3. HERO
   ========================================================================== */
.hero{
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background:
    linear-gradient(180deg, rgba(36,20,14,0.35) 0%, rgba(36,20,14,0.78) 78%, var(--dark-coffee) 100%),
    url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1920&q=80') center 60%/cover no-repeat;
}
.hero::after{
  content:"";
  position: absolute; inset: 0;
  background: radial-gradient(ellipse at 30% 20%, rgba(201,166,107,0.18), transparent 55%);
  pointer-events: none;
}
.hero-inner{
  position: relative;
  z-index: 2;
  padding-top: 90px;
  max-width: 760px;
}
.hero-eyebrow{
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: var(--gold);
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  margin-bottom: 26px;
  opacity: 0;
  animation: fadeUp 1s var(--ease) .2s forwards;
}
.hero-eyebrow .line{ width: 40px; height: 1px; background: var(--gold); }

.hero h1{
  font-family: var(--font-display);
  font-weight: 600;
  color: var(--white);
  font-size: clamp(2.6rem, 6.2vw, 5rem);
  line-height: 1.08;
  letter-spacing: -0.01em;
  opacity: 0;
  animation: fadeUp 1s var(--ease) .4s forwards;
}
.hero h1 em{
  font-style: italic;
  color: var(--gold);
  font-weight: 500;
}
.hero p.sub{
  margin-top: 26px;
  max-width: 520px;
  color: rgba(255,248,237,0.86);
  font-size: 1.12rem;
  opacity: 0;
  animation: fadeUp 1s var(--ease) .6s forwards;
}
.hero-buttons{
  margin-top: 42px;
  display: flex;
  gap: 18px;
  flex-wrap: wrap;
  opacity: 0;
  animation: fadeUp 1s var(--ease) .8s forwards;
}
.hero-tags{
  margin-top: 56px;
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 0.82rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(255,248,237,0.65);
  font-weight: 600;
  opacity: 0;
  animation: fadeUp 1s var(--ease) 1s forwards;
}
.hero-tags .dot{ width: 4px; height: 4px; border-radius: 50%; background: var(--gold); }

@keyframes fadeUp{
  from{ opacity: 0; transform: translateY(26px); }
  to{ opacity: 1; transform: translateY(0); }
}

.scroll-cue{
  position: absolute;
  bottom: 34px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  color: rgba(255,248,237,0.7);
  font-size: 0.7rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
}
.scroll-cue .stick{
  width: 1px; height: 40px;
  background: linear-gradient(180deg, var(--gold), transparent);
  position: relative;
  overflow: hidden;
}
.scroll-cue .stick::after{
  content:"";
  position: absolute;
  top: -40px; left: 0; width: 100%; height: 40px;
  background: linear-gradient(180deg, transparent, var(--white));
  animation: dropline 2.2s ease-in-out infinite;
}
@keyframes dropline{
  0%{ transform: translateY(0); }
  100%{ transform: translateY(80px); }
}

/* ==========================================================================
   4. ABOUT
   ========================================================================== */
.about{
  padding: 140px 0 110px;
  background: var(--cream);
}
.about-grid{
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 80px;
  align-items: center;
}
.about-visual{
  position: relative;
}
.about-visual img{
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
  width: 100%;
  height: 520px;
  object-fit: cover;
}
.about-badge{
  position: absolute;
  bottom: -30px;
  right: -30px;
  background: var(--dark-coffee);
  color: var(--cream);
  border-radius: 50%;
  width: 130px; height: 130px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-family: var(--font-display);
  font-size: 0.85rem;
  line-height: 1.3;
  box-shadow: var(--shadow-card);
  animation: spin-slow 18s linear infinite;
}
.about-badge span{ display: block; font-size: 1.7rem; font-weight: 700; color: var(--gold); animation: none; }
@keyframes spin-slow{ from{ transform: rotate(0deg); } to{ transform: rotate(360deg); } }
.about-badge b{ display:block; }

.about-text p{
  color: #5a4437;
  font-size: 1.04rem;
  margin-bottom: 18px;
  max-width: 520px;
}
.about-features{
  margin-top: 40px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}
.feature-mini{
  padding: 26px 20px;
  background: var(--white);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  transition: transform .45s var(--ease), box-shadow .45s var(--ease);
}
.feature-mini:hover{
  transform: translateY(-8px);
  box-shadow: 0 22px 40px -18px rgba(36,20,14,0.3);
}
.feature-mini .ico{ font-size: 1.6rem; margin-bottom: 14px; display:block; }
.feature-mini h4{
  font-family: var(--font-display);
  font-size: 1.02rem;
  margin-bottom: 8px;
  color: var(--dark-coffee);
}
.feature-mini p{
  font-size: 0.86rem;
  color: #7a6250;
  margin: 0;
}

/* ==========================================================================
   5. MENU
   ========================================================================== */
.menu-section{
  padding: 120px 0;
  background: var(--white);
  position: relative;
}
.filter-bar{
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: 56px;
}
.filter-btn{
  padding: 12px 26px;
  border-radius: 100px;
  border: 1.5px solid var(--beige);
  color: var(--espresso);
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.02em;
  transition: all .35s var(--ease);
  background: transparent;
}
.filter-btn:hover{ border-color: var(--caramel); color: var(--caramel); }
.filter-btn.active{
  background: var(--espresso);
  border-color: var(--espresso);
  color: var(--cream);
}

.menu-category{
  margin-bottom: 62px;
}
.menu-category-title{
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-weight: 600;
  color: var(--caramel);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 28px;
  display: flex;
  align-items: center;
  gap: 18px;
}
.menu-category-title::after{
  content:"";
  flex: 1;
  height: 1px;
  background: var(--beige);
}

.menu-grid{
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px 44px;
}
.menu-item{
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 14px;
  padding: 18px 0;
  border-bottom: 1px dashed rgba(59,36,24,0.18);
  transition: opacity .5s ease, transform .5s ease;
}
.menu-item.hidden{ display: none; }
.menu-item-name{
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 1.08rem;
  color: var(--dark-coffee);
  position: relative;
}
.menu-item-desc{
  display: block;
  font-family: var(--font-body);
  font-weight: 400;
  font-size: 0.8rem;
  color: #97806e;
  margin-top: 3px;
}
.menu-item-price{
  font-weight: 800;
  color: var(--caramel);
  font-size: 1rem;
  white-space: nowrap;
}

/* ==========================================================================
   6. SPECIALTY / BEST SELLERS
   ========================================================================== */
.specialty{
  padding: 120px 0;
  background: var(--cream);
}
.specialty-grid{
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
}
.specialty-card{
  background: var(--white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: transform .55s var(--ease), box-shadow .55s var(--ease);
  position: relative;
}
.specialty-card:hover{
  transform: translateY(-12px);
  box-shadow: 0 30px 50px -20px rgba(36,20,14,0.35);
}
.specialty-img{
  height: 260px;
  overflow: hidden;
  position: relative;
}
.specialty-img img{
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform .8s var(--ease);
}
.specialty-card:hover .specialty-img img{ transform: scale(1.1); }
.specialty-tag{
  position: absolute;
  top: 18px; left: 18px;
  background: rgba(255,248,237,0.92);
  color: var(--caramel);
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 7px 14px;
  border-radius: 100px;
}
.specialty-body{ padding: 30px 28px 32px; }
.specialty-body h3{
  font-family: var(--font-display);
  font-size: 1.35rem;
  margin-bottom: 12px;
  color: var(--dark-coffee);
}
.specialty-body p{
  color: #7a6250;
  font-size: 0.92rem;
  margin-bottom: 22px;
  min-height: 66px;
}

/* ==========================================================================
   7. WHY CHOOSE US
   ========================================================================== */
.why{
  padding: 130px 0;
  background: var(--dark-coffee);
  color: var(--cream);
  position: relative;
  overflow: hidden;
}
.why::before{
  content:"";
  position: absolute;
  width: 520px; height: 520px;
  background: radial-gradient(circle, rgba(201,166,107,0.15), transparent 70%);
  top: -160px; right: -160px;
  border-radius: 50%;
}
.why .section-title, .why .eyebrow{ color: var(--cream); }
.why .eyebrow{ color: var(--gold); }
.why .eyebrow::before{ background: var(--gold); }
.why-grid{
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 26px;
  position: relative;
  z-index: 1;
}
.why-card{
  padding: 40px 26px;
  border: 1px solid rgba(255,248,237,0.14);
  border-radius: var(--radius-md);
  background: rgba(255,248,237,0.03);
  transition: all .5s var(--ease);
}
.why-card:hover{
  background: rgba(201,166,107,0.1);
  border-color: rgba(201,166,107,0.4);
  transform: translateY(-8px);
}
.why-card .ico{
  font-size: 1.8rem;
  margin-bottom: 20px;
  display: block;
}
.why-card h4{
  font-family: var(--font-display);
  font-size: 1.1rem;
  margin-bottom: 10px;
}
.why-card p{
  font-size: 0.87rem;
  color: rgba(255,248,237,0.65);
}

/* ==========================================================================
   8. GALLERY
   ========================================================================== */
.gallery{
  padding: 120px 0;
  background: var(--white);
}
.gallery-grid{
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  grid-auto-rows: 130px;
  gap: 16px;
}
.gallery-item{
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-md);
  cursor: pointer;
}
.gallery-item:nth-child(1){ grid-column: span 3; grid-row: span 3; }
.gallery-item:nth-child(2){ grid-column: span 3; grid-row: span 2; }
.gallery-item:nth-child(3){ grid-column: span 3; grid-row: span 2; }
.gallery-item:nth-child(4){ grid-column: span 3; grid-row: span 3; }
.gallery-item:nth-child(5){ grid-column: span 3; grid-row: span 2; }
.gallery-item:nth-child(6){ grid-column: span 3; grid-row: span 2; }

.gallery-item img{
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform .7s var(--ease), filter .5s ease;
}
.gallery-item::after{
  content: attr(data-label);
  position: absolute;
  left: 20px; bottom: 18px;
  color: var(--white);
  font-family: var(--font-display);
  font-size: 1rem;
  opacity: 0;
  transform: translateY(10px);
  transition: all .45s var(--ease);
  z-index: 2;
}
.gallery-item::before{
  content:"";
  position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(36,20,14,0.75));
  opacity: 0;
  transition: opacity .45s ease;
  z-index: 1;
}
.gallery-item:hover::before, .gallery-item:hover::after{ opacity: 1; transform: translateY(0); }
.gallery-item:hover img{ transform: scale(1.12); }

/* ==========================================================================
   9. REVIEWS
   ========================================================================== */
.reviews{
  padding: 130px 0;
  background: var(--beige);
  position: relative;
}
.reviews .section-title, .reviews .section-sub{ color: var(--dark-coffee); }
.reviews .section-sub{ color: #5a4130; }

.testimonial-wrap{
  max-width: 720px;
  margin: 0 auto;
  position: relative;
}
.testimonial-track{
  overflow: hidden;
}
.testimonial-slides{
  display: flex;
  transition: transform .7s var(--ease);
}
.testimonial-slide{
  min-width: 100%;
  text-align: center;
  padding: 12px 30px;
}
.stars{
  color: var(--gold);
  font-size: 1.2rem;
  letter-spacing: 4px;
  margin-bottom: 26px;
}
.testimonial-slide p{
